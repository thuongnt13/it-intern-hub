@model List<ITInternHub.Models.ViewModels.CompanyInternStatsViewModel>
@{
    ViewData["Title"] = "Thống Kê Doanh Nghiệp Tiếp Nhận Sinh Viên";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="ri-building-2-line text-primary me-1"></i> Xếp hạng Đối tác Doanh nghiệp tiếp
            nhận thực tập</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên Doanh Nghiệp Đối Tác</th>
                            <th>Số lượng SV đã tiếp nhận</th>
                            <th>Mức độ hợp tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.CompanyName</td>
                                    <td class="text-primary fw-bold">@item.StudentCount sinh viên</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">Đối tác thân thiết</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <p class="mb-0">Chưa có dữ liệu thống kê tiếp nhận.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
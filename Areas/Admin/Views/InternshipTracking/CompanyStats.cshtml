@model List<ITInternHub.Models.ViewModels.CompanyInternStatsViewModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thống Kê Doanh Nghiệp Tiếp Nhận Sinh Viên";
    int totalInterns = Model?.Sum(x => x.StudentCount) ?? 0;
}

<div class="container-fluid p-0">
    <!-- NÚT ĐIỀU HƯỚNG VÀ TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="ri-building-2-line text-primary me-2"></i>Thống Kê Doanh Nghiệp Tiếp Nhận
            </h4>
            <small class="text-muted">Theo dõi mạng lưới đối tác tiếp nhận thực tập sinh viên của Khoa/Trường</small>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/InternshipTracking" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="ri-arrow-left-line me-1"></i> Sổ theo dõi thực tập
            </a>
            <a href="/Admin/InternshipTracking/Gradebook" class="btn btn-outline-info btn-sm rounded-pill px-3">
                <i class="ri-file-chart-line me-1"></i> Bảng điểm thực tập
            </a>
        </div>
    </div>

    <!-- 2 CARD TỔNG QUAN KPI -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4">
                <span class="text-muted text-uppercase fw-semibold small">Tổng đối tác tiếp nhận</span>
                <h3 class="fw-bold text-dark mt-2 mb-0">@(Model?.Count ?? 0)</h3>
                <small class="text-primary"><i class="ri-building-line me-1"></i>Doanh nghiệp hợp tác</small>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4">
                <span class="text-muted text-uppercase fw-semibold small">Tổng sinh viên có chỗ thực tập</span>
                <h3 class="fw-bold text-dark mt-2 mb-0">@totalInterns</h3>
                <small class="text-success"><i class="ri-user-star-line me-1"></i>Sinh viên chính thức</small>
            </div>
        </div>
    </div>

    <!-- BẢNG XẾP HẠNG DOANH NGHIỆP ĐỐI TÁC -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">
                <i class="ri-bar-chart-grouped-line text-success me-1"></i> Bảng xếp hạng số lượng tiếp nhận thực tập
                sinh
            </h6>
            <button class="btn btn-sm btn-outline-primary" onclick="window.print()">
                <i class="ri-printer-line me-1"></i> In báo cáo
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 text-center" style="width: 70px;">Thứ hạng</th>
                            <th>Tên Doanh Nghiệp Đối Tác</th>
                            <th class="text-center">Số lượng SV tiếp nhận</th>
                            <th>Tỷ lệ tiếp nhận</th>
                            <th class="text-end pe-4">Đánh giá mức độ hợp tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int rank = 1;
                            foreach (var item in Model)
                            {
                                double percentage = totalInterns > 0 ? Math.Round(((double)item.StudentCount / totalInterns) *
                        100, 1) : 0;
                                <tr>
                                    <td class="ps-4 text-center">
                                        @if (rank == 1)
                                        {
                                            <span class="badge rounded-circle bg-warning text-dark p-2"
                                                  title="Quán quân tiếp nhận">🥇</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="badge rounded-circle bg-secondary text-white p-2">🥈</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="badge rounded-circle bg-danger-subtle text-danger p-2">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted">@rank</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">@item.CompanyName</div>
                                        <small class="text-muted">Đối tác doanh nghiệp tiếp nhận thực tập chính khóa</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary fs-6 fw-bold px-3 py-2 rounded-pill">
                                            @item.StudentCount sinh viên
                                        </span>
                                    </td>
                                    <td style="width: 250px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar bg-success" role="progressbar"
                                                     style="width: @percentage%"></div>
                                            </div>
                                            <small class="text-muted fw-semibold">@percentage%</small>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.StudentCount >= 5)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                <i class="ri-star-fill text-warning me-1"></i> Đối tác Chiến lược
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill">
                                                Đối tác Thân thiết
                                            </span>
                                        }
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="ri-inbox-line display-4 text-muted d-block mb-2"></i>
                                    Chưa có dữ liệu sinh viên nào được ghi nhận vào sổ thực tập.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
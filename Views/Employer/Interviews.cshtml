@model IEnumerable<ITInternHub.Models.Entities.Interview>
@{
    ViewData["Title"] = "Quản lý Lịch hẹn Phỏng vấn";
}

@Html.AntiForgeryToken()

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: var(--brand-navy);"><i
                class="ri-calendar-event-line text-warning me-2"></i>Lịch hẹn Phỏng vấn Ứng viên</h4>
                <small class="text-muted">Theo dõi và cập nhật kết quả phỏng vấn tuyển dụng</small>
            </div>
            <a href="/Employer/Applications" class="btn btn-outline-primary btn-sm"><i class="ri-user-search-line me-1"></i>
                Sàng lọc CV</a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Ứng viên</th>
                                    <th>Vị trí ứng tuyển</th>
                                    <th>Thời gian phỏng vấn</th>
                                    <th>Hình thức / Địa điểm</th>
                                    <th>Người phỏng vấn</th>
                                    <th>Kết quả</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var iv in Model)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <h6 class="mb-0 fw-bold">@iv.Application.Student.User.FullName</h6>
                                                <small class="text-muted">MSSV: @iv.Application.Student.StudentCode</small>
                                            </td>
                                            <td><span class="small fw-semibold">@iv.Application.JobPost.Title</span></td>
                                            <td>
                                                <span class="badge bg-warning-subtle text-warning fw-bold fs-6">
                                                    <i class="ri-time-line"></i> @iv.StartTime.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </td>
                                            <td>
                                                @if (iv.Format == 1)
                                                {
                                                    <span class="badge bg-info-subtle text-info mb-1">Online</span><br />
                                                    <a href="@iv.LocationOrLink" target="_blank" class="small text-decoration-none"><i
                                                        class="ri-external-link-line"></i> Vào phòng họp</a>
                                                    }
                                        else
                                                    {
                                                        <span class="badge bg-light text-dark border mb-1">Trực tiếp</span><br />
                                                        <small class="text-muted">@iv.LocationOrLink</small>
                                                    }
                                                </td>
                                                <td>@(iv.InterviewerName ?? "Chưa chỉ định")</td>
                                                <td>
                                                    @if (string.IsNullOrEmpty(iv.InterviewResult))
                                                    {
                                                        <span class="badge bg-light text-muted border">Chưa có kết quả</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success">@iv.InterviewResult</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                                            onclick="updateResult(@iv.Id)">
                                                        <i class="ri-edit-line"></i> Nhập kết quả
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                        else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">Chưa có lịch phỏng vấn nào được lên
                                                lịch.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                        function updateResult(ivId) {
                            const res = prompt('Nhập kết quả phỏng vấn (Ví dụ: Đạt vòng 1, Đề xuất nhận việc, Chưa phù hợp...):');
                            if (!res) return;

                            const formData = new FormData();
                            formData.append('interviewId', ivId);
                            formData.append('result', res);
                            formData.append('__RequestVerificationToken', token);

                            fetch('/Employer/Interviews/UpdateResult', { method: 'POST', body: formData })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        alert(data.message);
                                        location.reload();
                                    } else {
                                        alert('Lỗi: ' + data.message);
                                    }
                                })
                                .catch(err => alert('Lỗi kết nối: ' + err));
                        }
                    </script>
                }
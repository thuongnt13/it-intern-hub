@model IEnumerable<ITInternHub.Models.Entities.WeeklyReport>
@{
    ViewData["Title"] = "Nhật ký thực tập hàng tuần";
    bool hasAccepted = ViewBag.HasAcceptedRecord ?? false;
    var record = ViewBag.InternshipRecord as ITInternHub.Models.Entities.Record;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: var(--brand-navy);"><i
                class="ri-booklet-line text-info me-2"></i>Nhật ký thực tập hàng tuần</h4>
                <small class="text-muted">Báo cáo tiến độ để Mentor doanh nghiệp đánh giá và Khoa CNTT theo dõi</small>
            </div>
            @if (hasAccepted)
            {
                <button class="btn btn-primary btn-sm px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#createLogModal"
                        style="background-color: var(--brand-blue);">
                    <i class="ri-add-line me-1"></i> Báo cáo tuần mới
                </button>
            }
        </div>

        @if (!hasAccepted)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="ri-lock-line display-3 text-warning mb-3"></i>
                <h5 class="fw-bold text-dark">Chưa có giao kết thực tập chính thức</h5>
                <p class="text-muted col-md-6 mx-auto">
                    Chức năng Nhật ký thực tập tuần chỉ kích hoạt khi bạn đã trúng tuyển và được Doanh nghiệp tiếp nhận chính
                    thức vào kỳ thực tập của Nhà trường.
                </p>
                <div>
                    <a href="/Student/Applications" class="btn btn-outline-primary btn-sm px-3">Kiểm tra đơn ứng tuyển của
                        tôi</a>
                    </div>
                </div>
            }
    else
            {
                <!-- THÔNG TIN ĐƠN VỊ THỰC TẬP -->
                <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-primary-subtle border-primary">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Đơn vị thực tập: @record?.Company?.CompanyName</h6>
                            <small class="text-secondary"><i class="ri-user-star-line me-1"></i>Người hướng dẫn (Mentor):
                                @record?.SupervisorName (@record?.SupervisorEmail)</small>
                            </div>
                            <span class="badge bg-success px-3 py-2 rounded-pill">Đang thực tập</span>
                        </div>
                    </div>

                    <!-- DANH SÁCH BÁO CÁO TUẦN -->
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Tuần số</th>
                                            <th>Nội dung công việc đã thực hiện</th>
                                            <th>Ngày nộp</th>
                                            <th>Trạng thái</th>
                                            <th class="pe-4">Nhận xét của Mentor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            foreach (var log in Model)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-bold text-primary">Tuần @log.WeekNumber</td>
                                                    <td style="max-width: 400px; white-space: pre-line;">@log.WorkSummary</td>
                                                    <td class="small text-muted">@log.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>
                                                        @if (log.Status == 2)
                                                        {
                                                            <span class="badge bg-success">Đã duyệt</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">Chờ nhận xét</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4 small text-secondary">
                                                        @(string.IsNullOrEmpty(log.SupervisorFeedback) ? "Chưa có nhận xét" :
                                            log.SupervisorFeedback)
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted">
                                                    <p class="mb-0">Bạn chưa gửi báo cáo thực tập nào. Hãy bấm <strong>Báo cáo tuần
                                                        mới</strong> ở trên!</p>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- MODAL NỘP NHẬT KÝ TUẦN -->
                        <div class="modal fade" id="createLogModal" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="CreateWeeklyLog" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header">
                                            <h6 class="modal-title fw-bold text-primary"><i class="ri-file-add-line me-1"></i> Báo cáo Nhật
                                                ký thực tập tuần</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Báo cáo cho tuần thứ mấy? *</label>
                                                    <input type="number" name="weekNumber" class="form-control" min="1" max="20"
                                                           value="@((Model?.Count() ?? 0) + 1)" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Chi tiết công việc / Đồ án đã hoàn thành trong
                                                        tuần *</label>
                                                        <textarea name="workSummary" class="form-control" rows="5" required
                                                                  placeholder="- Tìm hiểu Clean Architecture trong ASP.NET Core&#10;- Xây dựng API và liên kết CSDL SQL Server&#10;- Khó khăn gặp phải và giải pháp..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary btn-sm px-4">Gửi báo cáo tuần</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
@model ITInternHub.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Cổng Kết Nối Tuyển Dụng & Thực Tập Sinh CNTT";
    var industries = ViewBag.Industries as List<ITInternHub.Models.Entities.Industry>;
    var popularSkills = ViewBag.PopularSkills as List<ITInternHub.Models.Entities.Skill>;
}

<!-- HERO BANNER TÌM KIẾM CHUẨN TOPCV -->
<div class="py-5" style="background: linear-gradient(135deg, #103057 0%, #0066cc 100%);">
    <div class="container text-center text-white">
        <h2 class="fw-bold mb-2">Tìm kiếm Cơ hội Thực tập CNTT Đột phá</h2>
        <p class="text-white-50 mb-4 small">Kết nối trực tiếp sinh viên Kỹ sư CNTT với hàng trăm Doanh nghiệp Công nghệ
            hàng đầu</p>

            <!-- THANH TÌM KIẾM ĐA TIÊU CHÍ -->
            <div class="card border-0 shadow-lg rounded-4 p-3 mx-auto col-lg-11 text-start">
                <form method="get" asp-action="Index" class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i
                                class="ri-search-line"></i></span>
                                <input type="text" name="keyword" value="@ViewBag.CurrentKeyword"
                                       class="form-control border-start-0" placeholder="Vị trí tuyển dụng, công ty..." />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="industryId" class="form-select">
                                <option value="">-- Tất cả Lĩnh vực --</option>
                                @if (industries != null)
                                {
                                    foreach (var ind in industries)
                                    {
                                        <option value="@ind.Id" selected="@(ViewBag.CurrentIndustryId == ind.Id)">@ind.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="city" class="form-select">
                                <option value="">-- Tất cả Địa điểm --</option>
                                <option value="Hà Nội" selected="@(ViewBag.CurrentCity == "Hà Nội")">Hà Nội</option>
                                <option value="Đà Nẵng" selected="@(ViewBag.CurrentCity == "Đà Nẵng")">Đà Nẵng</option>
                                <option value="TP. Hồ Chí Minh" selected="@(ViewBag.CurrentCity == "TP. Hồ Chí Minh")">TP. Hồ
                                    Chí Minh</option>
                                    <option value="TP. Vinh" selected="@(ViewBag.CurrentCity == "TP. Vinh")">TP. Vinh</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"
                                        style="background-color: var(--brand-blue);">
                                    <i class="ri-search-2-line me-1"></i> Tìm việc
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- GỢI Ý THẺ KỸ NĂNG HOT -->
                    <div class="mt-3 d-flex flex-wrap justify-content-center align-items-center gap-2">
                        <span class="small text-white-50">Gợi ý từ khóa:</span>
                        @if (popularSkills != null)
                        {
                            foreach (var sk in popularSkills)
                            {
                                <a href="/?skill=@sk.Name"
                                   class="badge rounded-pill bg-white text-primary text-decoration-none px-3 py-2 fw-semibold shadow-sm">
                                    @sk.Name
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- DANH SÁCH BÀI ĐĂNG TUYỂN DỤNG -->
            <div class="container py-5">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark"><i class="ri-briefcase-4-line text-primary me-2"></i>Việc làm thực tập
                            nổi bật</h4>
                            <small class="text-muted">Tìm thấy <strong>@Model.TotalJobsCount</strong> vị trí đang mở tuyển</small>
                        </div>
        
                        @if (Model.IsStudentLoggedIn)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fs-6 border border-success-subtle">
                                <i class="ri-sparkling-fill me-1"></i> Đã tự động sắp xếp theo độ tương thích (% Match) với hồ sơ của bạn
                            </span>
                        }
                    </div>

                    <div class="row g-4">
                        @if (Model.FeaturedJobs.Any())
                        {
                            foreach (var job in Model.FeaturedJobs)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div
                                        class="card h-100 border-0 shadow-sm rounded-4 p-3 job-card d-flex flex-column justify-content-between">
                                        <div>
                                            <!-- Header Card: Logo & Tên công ty -->
                                            <div class="d-flex align-items-start gap-3 mb-3">
                                                @* <img src="@job.CompanyLogo" alt="@job.CompanyName" class="rounded-3 border"
                                                     style="width: 55px; height: 55px; object-fit: contain; padding: 2px;" /> *@
                                                <div class="overflow-hidden">
                                                    <h6 class="fw-bold mb-1 text-truncate" title="@job.Title">
                                                        <a href="/Jobs/Detail/@job.Id" class="text-dark text-decoration-none">@job.Title</a>
                                                    </h6>
                                                    <p class="text-muted small mb-0 text-truncate">@job.CompanyName</p>
                                                </div>
                                            </div>

                                            <!-- Trợ cấp & Khu vực -->
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">
                                                    @(job.IsUnpaid ? "Không lương" : $"{job.SalaryMin:N0} - {job.SalaryMax:N0} đ")
                                                </span>
                                                <span class="badge bg-light text-secondary border"><i class="ri-map-pin-line"></i>
                                                    @job.City</span>
                                                </div>

                                                <!-- Thẻ kỹ năng yêu cầu -->
                                                <div class="mb-3">
                                                    @foreach (var skill in job.RequiredSkills.Take(3))
                                                    {
                                                        <span class="badge bg-light text-dark border me-1 mb-1">@skill</span>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Footer Card: Match Score & Nút Ứng tuyển -->
                                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                                                @if (Model.IsStudentLoggedIn)
                                                {
                                                    <span class="badge bg-success-subtle text-success fw-bold fs-6" title="Độ tương thích kỹ năng">
                                                        <i class="ri-check-line"></i> Khớp @job.MatchScore%
                                                    </span>
                                                }
                                                else
                                                {
                                                    <small class="text-muted"><i class="ri-time-line"></i> @job.Deadline.ToString("dd/MM/yyyy")</small>
                                                }
                                                <a href="/Jobs/Detail/@job.Id"
                                                   class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">Ứng tuyển</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
        else
                            {
                                <div class="col-12 text-center py-5">
                                    <i class="ri-inbox-line display-4 text-muted"></i>
                                    <p class="mt-2 text-muted">Không tìm thấy bài đăng tuyển nào phù hợp với bộ lọc hiện tại.</p>
                                    <a href="/" class="btn btn-sm btn-outline-primary">Xóa bộ lọc</a>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- KHỐI PHÂN TRANG BOOTSTRAP 5 -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Job pagination" class="mt-5">
                            <ul class="pagination justify-content-center">
                                <!-- Nút Trước -->
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/?page=@(Model.CurrentPage - 1)&keyword=@ViewBag.CurrentKeyword&industryId=@ViewBag.CurrentIndustryId&city=@ViewBag.CurrentCity&skill=@ViewBag.CurrentSkill">
                                        <i class="ri-arrow-left-s-line"></i> Trước
                                    </a>
                                </li>

                                <!-- Danh sách số trang -->
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link @(p == Model.CurrentPage ? "bg-primary border-primary" : "")"
                                           href="/?page=@p&keyword=@ViewBag.CurrentKeyword&industryId=@ViewBag.CurrentIndustryId&city=@ViewBag.CurrentCity&skill=@ViewBag.CurrentSkill">
                                            @p
                                        </a>
                                    </li>
                                }

                                <!-- Nút Sau -->
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link"
                                       href="/?page=@(Model.CurrentPage + 1)&keyword=@ViewBag.CurrentKeyword&industryId=@ViewBag.CurrentIndustryId&city=@ViewBag.CurrentCity&skill=@ViewBag.CurrentSkill">
                                        Sau <i class="ri-arrow-right-s-line"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
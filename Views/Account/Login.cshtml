@model ITInternHub.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tài khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="text-center mb-4">
                    <h4 class="fw-bold" style="color: var(--brand-navy);">Chào mừng bạn trở lại!</h4>
                    <p class="text-muted small">Cùng phát triển sự nghiệp thực tập sinh CNTT tại IT-InternHub</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label small fw-semibold">Tên đăng nhập hoặc
                            Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i
                                    class="ri-user-line text-muted"></i></span>
                                    <input asp-for="UsernameOrEmail" class="form-control border-start-0"
                                           placeholder="Nhập username hoặc email" autofocus />
                                </div>
                                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i
                                        class="ri-lock-line text-muted"></i></span>
                                        <input asp-for="Password" class="form-control border-start-0"
                                               placeholder="Nhập mật khẩu của bạn" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" />
                                        <label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng
                                            nhập</label>
                                        </div>
                                        <a href="#" class="text-decoration-none small fw-semibold text-primary">Quên mật khẩu?</a>
                                    </div>

                                    <button type="submit" class="btn w-100 py-2 fw-semibold text-white mb-3"
                                            style="background-color: var(--brand-navy);">
                                        <i class="ri-login-box-line me-1"></i> Đăng nhập
                                    </button>

                                    <div class="text-center small text-muted">
                                        Bạn chưa có tài khoản? <a asp-action="Register"
                                                                  class="text-primary fw-bold text-decoration-none">Đăng ký ngay</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>